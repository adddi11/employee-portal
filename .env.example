# ---------- Database (MongoDB Atlas) ----------
# Atlas connection string: Atlas UI → Connect → Drivers → copy the URI
# (must include the database name in the path for clarity, e.g. /emp_portal)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/emp_portal?retryWrites=true&w=majority

# Local development (mongod on 27017):
# MONGODB_URI=mongodb://127.0.0.1:27017

# ---------- Security ----------
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_HOURS=24

# ---------- App ----------
DB_NAME=emp_portal
AUTO_SEED=true
PORT=3000
